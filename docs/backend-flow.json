  "cards": [
    {
      "dot": "cyan",
      "title": "Arquitectura en Capas Limpia (Layered Clean Architecture)",
      "items": [
        "Routers desacoplados: sólo gestionan transporte HTTP, status codes y validación de esquemas",
        "Services independientes: concentran transacciones atómicas (ej: verificación y descuento de stock)",
        "Repositories dedicados: aíslan completamente las consultas SQLModel y la sesión de base de datos"
      ]
    },
    {
      "dot": "emerald",
      "title": "Inyección de Dependencias y Seguridad Robusta",
      "items": [
        "deps.py maneja el ciclo de vida de la sesión (Session(engine)) y verificación OAuth2PasswordBearer",
        "Tokens JWT (HS256) con expiración y contraseñas cifradas mediante hashing seguro Bcrypt"
      ]
    },
    {
      "dot": "rose",
      "title": "Persistencia Relacional Real en Docker",
      "items": [
        "Base de datos PostgreSQL 15 ejecutándose en contenedor Docker oficial",
        "Modelos SQLModel que unifican tipos Pydantic y mapeo relacional SQLAlchemy sin duplicar esquemas"
      ]
    }
  ]
